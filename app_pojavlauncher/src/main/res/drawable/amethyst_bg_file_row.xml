<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#447C4DFF">
    <item>
        <inset
            android:insetLeft="8dp"
            android:insetTop="3dp"
            android:insetRight="8dp"
            android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <solid android:color="#1A1626" />
                <stroke android:width="1dp" android:color="#2E2644" />
                <corners android:radius="12dp" />
            </shape>
        </inset>
    </item>
</ripple>
